{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**/*.pdf" },
        { "path": "$HOME/**/*.PDF" },
        { "path": "$DOCUMENT/**/*.pdf" },
        { "path": "$DOCUMENT/**/*.PDF" },
        { "path": "$DOWNLOAD/**/*.pdf" },
        { "path": "$DOWNLOAD/**/*.PDF" }
      ]
    }
  ]
}
