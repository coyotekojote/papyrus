{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-exists",
    "allow-greet",
    "allow-create-bookmark",
    "allow-resolve-bookmark",
    "allow-load-annotations",
    "allow-save-annotations",
    "allow-load-notes",
    "allow-save-notes",
    "allow-save-clip",
    "allow-load-clip",
    "allow-sidecar-status",
    "allow-load-settings",
    "allow-save-settings",
    "allow-save-api-key",
    "allow-delete-api-key",
    "allow-api-key-status",
    "allow-translate",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**/*.pdf" },
        { "path": "$HOME/**/*.PDF" },
        { "path": "$DOCUMENT/**/*.pdf" },
        { "path": "$DOCUMENT/**/*.PDF" },
        { "path": "$DOWNLOAD/**/*.pdf" },
        { "path": "$DOWNLOAD/**/*.PDF" }
      ]
    }
  ]
}
