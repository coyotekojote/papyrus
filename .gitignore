# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.local

# Tauri
src-tauri/target/
# Editor autocompletion schemas only; regenerated on every build. gen/apple is
# tracked — see src-tauri/gen/apple/.gitignore for its own build-artifact
# excludes (Tauri's own template ignores build/ there, not the whole tree).
src-tauri/gen/schemas/

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env
.env
.env*.local

# Coverage
coverage/

# pdf.js runtime assets copied from node_modules at build time
public/pdfjs/

# Synthetic large PDF generated by scripts/generate-bench-pdf.mjs for `npm run bench`
bench/fixtures/

# Claude Code のセッションローカルな状態
.claude/scheduled_tasks.lock
.claude/settings.local.json
